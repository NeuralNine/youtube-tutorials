    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet photoBinary;\ntry {\n  const photo = $('Get Picture File').first();\n  const bins = (photo && photo.binary) || {};\n  if (Object.keys(bins).length) photoBinary = bins;\n} catch (e) {\n  photoBinary = undefined;\n}\nreturn items.map((item) => {\n  const out = { json: { ...item.json } };\n  if (photoBinary && !item.binary) out.binary = photoBinary;\n  return out;\n});"
      },
