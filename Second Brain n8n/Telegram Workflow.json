      "webhookId": "0f32953e-aebe-4817-81a3-38ceb403bf1b"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const bins = item.binary || {};\nfor (const key of Object.keys(bins)) {\n  const meta = bins[key];\n  let name = String(meta.fileName || 'voice');\n  const dot = name.lastIndexOf('.');\n  if (/\\.oga$/i.test(name)) {\n    name = name.replace(/\\.oga$/i, '.ogg');\n  } else if (dot <= 0) {\n    name = name + '.ogg';\n  }\n  meta.fileName = name;\n  meta.mimeType = 'audio/ogg';\n  meta.fileExtension = 'ogg';\n}\nreturn item;"
      },
