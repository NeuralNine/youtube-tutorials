    },
    {
      "parameters": {
        "jsCode": "const content = String($('When Executed by Another Workflow').first().json.content || '');\nconst size = 2000;\nconst chunks = [];\nfor (let i = 0; i < content.length; i += size) {\n  chunks.push(content.slice(i, i + size));\n}\nif (chunks.length === 0) {\n  chunks.push('');\n}\nreturn chunks.map((chunk, index) => ({ json: { chunk: chunk, chunk_index: index } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
